# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
*.lock
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# turborepo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# apps/mobile/.env has no secrets (EXPO_PUBLIC_* vars are inlined into the JS
# bundle) and needs to be committed for the app to run out of the box -
# personal overrides still go in .env.local, which stays ignored.
!apps/mobile/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
