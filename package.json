{
  "name": "what-box",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build --turbo",
    "vercel-build": "sh scripts/vercel-build.sh",
    "start": "next start",
    "env:pull": "vercel env pull .env.development.local --environment=development",
    "env:pull:prod": "vercel env pull .env.production.local --environment=production",
    "db:up": "dotenv -e .env.development.local -- drizzle-kit up",
    "db:push": "dotenv -e .env.development.local -- drizzle-kit push",
    "db:push:prod": "dotenv -e .env.production.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.development.local -- drizzle-kit studio",
    "db:studio:prod": "dotenv -e .env.production.local -- drizzle-kit studio",
    "db:generate": "dotenv -e .env.development.local -- drizzle-kit generate",
    "db:generate:prod": "dotenv -e .env.production.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.development.local -- drizzle-kit migrate",
    "db:migrate:prod": "dotenv -e .env.production.local -- drizzle-kit migrate",
    "lint": "eslint",
    "verify": "sh scripts/verify.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.0.2",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.0.0",
    "@xstate/react": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.563.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "react-qr-code": "^2.0.18",
    "resend": "^6.22.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "uuid": "^13.0.0",
    "xstate": "^5.25.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
